# Server-only ElevenLabs API key
ELEVENLABS_API_KEY=

# Normal visitor-facing agents
ELEVENLABS_AGENT_BERNAYS=
ELEVENLABS_AGENT_IVY_LEE=
ELEVENLABS_AGENT_LIPPMANN=
ELEVENLABS_AGENT_ARTHUR_PAGE=
PRMUSEUM_ENABLED_AGENTS=bernays,ivy-lee,lippmann,arthur-page

# Dedicated dialogue copies. These should have the same voices/knowledge/personas
# but NO First Message, transfer_to_agent, syncActiveAgent, or setActiveAgent tools.
ELEVENLABS_DIALOGUE_AGENT_BERNAYS=
ELEVENLABS_DIALOGUE_AGENT_IVY_LEE=
ELEVENLABS_DIALOGUE_AGENT_LIPPMANN=
ELEVENLABS_DIALOGUE_AGENT_ARTHUR_PAGE=
PRMUSEUM_DIALOGUE_ENABLED_AGENTS=bernays,ivy-lee,lippmann,arthur-page

# Backend-gated AI Discussion mode
PRMUSEUM_AI_DIALOGUE_ENABLED=false
PRMUSEUM_AI_DIALOGUE_MAX_TURNS=6

# Visitor mode
NEXT_PUBLIC_DEFAULT_AGENT=bernays
NEXT_PUBLIC_SESSION_SECONDS=600
